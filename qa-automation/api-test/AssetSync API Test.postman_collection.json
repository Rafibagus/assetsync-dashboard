            "0",
            "1"
          ],
          "port": "8000",
          "path": [
            "api",
            "items"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. [POST] Add Item Invalid - Negative",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Memastikan server menolak request (Status 422 Unprocessable Entity bawaan Laravel)\r",
              "pm.test(\"Status code is 422 (Ditolak karena validasi gagal)\", function () {\r",
              "    pm.response.to.have.status(422);\r",
              "});\r",
              "\r",
              "// 2. Memastikan server mengembalikan pesan error yang jelas\r",
              "pm.test(\"Mendapatkan struktur error validasi\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Harus ada objek 'errors' di dalam respons\r",
              "    pm.expect(jsonData).to.have.property('errors');\r",
              "});\r",
              "\r",
              "// 3. Memastikan error spesifik untuk kolom yang salah benar-benar muncul\r",
              "pm.test(\"Validasi mendeteksi nama kosong dan harga minus\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Mengecek apakah error untuk 'name' terdeteksi\r",
              "    pm.expect(jsonData.errors).to.have.property('name');\r",
              "    \r",
              "    // Mengecek apakah error untuk 'price' terdeteksi\r",
              "    pm.expect(jsonData.errors).to.have.property('price');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],

  "item": [
    {
      "name": "1. [GET] Get All Items - Positive",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Memastikan server merespons dengan status sukses (200 OK)\r",
              "pm.test(\"Status code is 200 (Sukses)\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Memastikan format balasan adalah array (daftar) dan merespons cukup cepat\r",
              "pm.test(\"Data yang dikembalikan berupa Array\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Waktu respons kurang dari 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },

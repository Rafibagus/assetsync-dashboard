    {
      "name": "2. [POST] Add Item - Positive",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Memastikan statusnya 201 (Berhasil Dibuat/Created)\r",
              "pm.test(\"Status code is 201 (Created)\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// 2. Memvalidasi bahwa data yang tersimpan benar-benar sesuai dengan inputan kita\r",
              "pm.test(\"Nama barang dan harga tersimpan dengan benar\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Mengecek spesifik nilainya\r",
              "    pm.expect(jsonData.name).to.eql(\"Keyboard Mechanical API\");\r",
              "    pm.expect(jsonData.category).to.eql(\"Elektronik\");\r",
              "});\r",
              "\r",
              "// 3. Memastikan sistem otomatis membuat ID untuk barang baru\r",
              "pm.test(\"Sistem berhasil men-generate ID\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.not.be.undefined;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"Keyboard Mechanical API\",\r\n    \"category\": \"Elektronik\",\r\n    \"stock\": 25,\r\n    \"price\": 150000\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/items",
          "protocol": "http",
          "host": [
            "127",
